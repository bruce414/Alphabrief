# Database — use the same DB name, user, and password as DOCKER_POSTGRES_* below
DATABASE_URL=postgresql+psycopg://alphabrief_user:alphabrief_password@localhost:5432/alphabrief

# Docker Compose (postgres). DATABASE_URL must match these three values.
# DOCKER_POSTGRES_DB=alphabrief
# DOCKER_POSTGRES_USER=alphabrief_user
# DOCKER_POSTGRES_PASSWORD=alphabrief_password

APP_ENV=local

# Backend
APP_NAME=Alphabrief API
APP_DEBUG=true

# CORS — comma-separated origins for the React/Vite dev server (override as needed)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# If/when you add API keys:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# POLYGON_API_KEY=
