# Postgres — compose uses POSTGRES_*; if omitted, falls back to DOCKER_POSTGRES_* (legacy names).
POSTGRES_DB=alphabrief
POSTGRES_USER=alphabrief
POSTGRES_PASSWORD=alphabrief
# DOCKER_POSTGRES_DB=alphabrief
# DOCKER_POSTGRES_USER=alphabrief
# DOCKER_POSTGRES_PASSWORD=alphabrief

# App DB URL — must use asyncpg. User, password, host, port, and DB name must match the Postgres container.
DATABASE_URL=postgresql+asyncpg://alphabrief:alphabrief@localhost:5432/alphabrief

# dev | test | prod (aliases: development/local → dev, production → prod, ci → test)
ENVIRONMENT=dev

SECRET_KEY=change-me-generate-a-strong-secret-for-production

# Backend
APP_NAME=Alphabrief API
APP_DEBUG=true

# CORS — comma-separated origins for the React/Vite dev server (override as needed)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# If/when you add API keys:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# POLYGON_API_KEY=
# AI provider: "mock" or "anthropic"
AI_PROVIDER=mock
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6
